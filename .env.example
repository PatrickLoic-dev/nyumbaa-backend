# App
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Supabase
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="your-anon-key"          # Settings → API Keys → anon public
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"  # Settings → API Keys → service_role secret

# Resend
RESEND_API_KEY="re_xxxxxxxxxxxx"
RESEND_FROM_EMAIL="noreply@nyumbaa.app"

# DeepL
DEEPL_API_KEY="your-deepl-api-key"

# Supabase Storage (bucket pour les images de posts)
SUPABASE_STORAGE_BUCKET="post-images"

# AWS Rekognition (modération images)
AWS_REGION="eu-west-1"
AWS_ACCESS_KEY_ID="your-access-key-id"
AWS_SECRET_ACCESS_KEY="your-secret-access-key"

# Redis (BullMQ)
REDIS_URL="redis://localhost:6379"

# Perspective API (moderation)
PERSPECTIVE_API_KEY="your-perspective-api-key"

# CORS
CORS_ORIGIN="*"

# Throttle
THROTTLE_TTL=60
THROTTLE_LIMIT=100
