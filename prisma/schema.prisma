generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum AppLanguage {
  fr
  en
  sw
  yo
  ha
}

enum PostVisibility {
  public
  followers
  private
}

enum PostStatus {
  published
  under_review
  removed
}

enum PostImageStatus {
  pending_review
  approved
  rejected
}

enum CommentStatus {
  published
  flagged
  removed
}

enum ConversationType {
  private
  group
}

enum MessageStatus {
  sent
  delivered
  read
}

enum MemberRole {
  admin
  moderator
  member
}

